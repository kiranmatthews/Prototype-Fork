{
  "name": "board-platformer-proto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:levels": "node tools/validate-levels.mjs",
    "check:ground": "node tools/validate-ground-acceleration.mjs",
    "check:editor-roundtrip": "node tools/validate-editor-roundtrip.mjs",
    "check:interpolation": "node tools/validate-render-interpolation.mjs",
    "check:editor-capture": "node tools/validate-editor-roundtrip.mjs --strict-hand-built",
    "check:ocean": "node tools/validate-ocean-port.mjs && node tools/test-ocean-formulas.mjs && node tools/test-unity-post.mjs && node tools/test-unity-smaa.mjs",
    "character:doctor": "python3 tools/tripo-character/tripo_character.py doctor",
    "character:generate": "python3 tools/tripo-character/tripo_character.py generate",
    "character:test": "python3 -m unittest discover -s tools/tripo-character/tests -p 'test_*.py'",
    "build": "npm run check:levels && npm run check:ground && npm run check:editor-roundtrip && npm run check:interpolation && npm run check:ocean && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "three": "^0.166.1",
    "three-mesh-bvh": "0.9.14"
  },
  "devDependencies": {
    "@types/three": "^0.166.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.11"
  }
}
