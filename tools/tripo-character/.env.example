# Choose one authentication route. Prefer `tripo login`, which stores a named
# profile outside this repository and never exposes a key here.
# TRIPO_PROFILE=default

# Headless/CI fallback only. Never commit the real value.
# TRIPO_API_KEY=<set-outside-this-repository>

# Optional output root used by the wrapper documentation.
TRIPO_CHARACTER_OUT=tools/tripo-character/work
