{
  "name": "boneman-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "BONEMAN \u2014 fully offline desktop game",
  "author": "Prototype Fork contributors",
  "license": "Apache-2.0",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir --publish never -c.mac.identity=- -c.mac.notarize=false -c.mac.entitlements=resources/entitlements.candidate.plist -c.mac.entitlementsInherit=resources/entitlements.candidate.plist",
    "dist": "electron-builder --publish never -c.mac.identity=- -c.mac.notarize=false -c.mac.entitlements=resources/entitlements.candidate.plist -c.mac.entitlementsInherit=resources/entitlements.candidate.plist",
    "test": "node --test ../tools/desktop/policy.test.mjs",
    "smoke": "node ../tools/desktop/smoke.mjs",
    "release": "electron-builder --publish never"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.0"
  },
  "build": {
    "appId": "com.prototypefork.boneman",
    "productName": "BONEMAN",
    "artifactName": "BONEMAN-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "main.cjs",
      "policy.cjs",
      "protocol.cjs",
      "web/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "afterPack": "./after-pack.cjs",
    "publish": null,
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game",
      "maintainer": "Prototype Fork contributors",
      "executableName": "boneman"
    }
  }
}
