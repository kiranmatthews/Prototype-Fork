@@ -0,0 +1,8 @@
+import type { Matrix4 } from 'three';
+
+/** Nearby instances share a draw; each camera and shadow frustum can reject
+ * the other cells without swapping or removing any authored geometry. */
+export function carlisleBatchCell(matrix:Matrix4) {
+  const e=matrix.elements;
+  return `${Math.floor(e[12]/48)}:${Math.floor(e[13]/48)}:${Math.floor(e[14]/48)}`;
+}
